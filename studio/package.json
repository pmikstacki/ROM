{
  "name": "rom-studio",
  "private": true,
  "version": "0.0.2",
  "type": "module",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "test": "playwright test --config tests/components/playwright.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 43172 --strictPort",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:components": "npm run build:components && playwright test --config tests/components/playwright.config.ts",
    "build:components": "vite build --mode components --outDir .component-dist",
    "preview:components": "vite preview --outDir .component-dist --host 127.0.0.1 --port 43173 --strictPort"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
