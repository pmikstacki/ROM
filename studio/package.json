    "embla-carousel-svelte": "8.6.0",
    "formsnap": "2.0.1",
    "layerchart": "2.5.1",
    "mode-watcher": "1.1.0",
    "paneforge": "1.0.2",
    "svelte": "5.57.1",
    "svelte-sonner": "1.2.1",
    "sveltekit-superforms": "2.31.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
