{
  "name": "rom-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "vite build",
    "test": "playwright test --config tests/components/playwright.config.ts",
    "preview": "vite preview --host 127.0.0.1 --port 43172 --strictPort",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:components": "corepack pnpm run build:components && playwright test --config tests/components/playwright.config.ts",
    "build:components": "vite build --mode components --outDir .component-dist",
    "preview:components": "vite preview --outDir .component-dist --host 127.0.0.1 --port 43173 --strictPort"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.51.0",
    "bits-ui": "2.19.5",
    "clsx": "2.1.1",
    "cn": "0.3.3",
    "embla-carousel-svelte": "8.6.0",
    "formsnap": "2.0.1",
    "layerchart": "2.5.1",
    "mode-watcher": "1.1.0",
    "paneforge": "1.0.2",
    "svelte": "5.57.1",
    "svelte-dnd-action": "0.9.80",
    "svelte-sonner": "1.2.1",
    "sveltekit-superforms": "2.31.0",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "tw-animate-css": "1.4.0",
    "vaul-svelte": "1.0.0-next.7",
    "shadcn-svelte": "1.7.0",
    "tailwindcss": "4.3.3",
    "rom-ui": "https://github.com/pmikstacki/rom-ui/releases/download/v0.1.0-alpha.7/rom-ui-0.1.0-alpha.7.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.2"
  },
  "overrides": {
    "cookie": "0.7.2"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./controls": {
      "types": "./src/controls.ts",
      "svelte": "./src/controls.ts",
      "default": "./src/controls.ts"
    },
    "./styles": {
      "types": "./src/styles.d.ts",
      "default": "./src/app.css"
    },
    "./client": {
      "types": "./src/client.ts",
      "svelte": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./recovery": {
      "types": "./src/recovery.ts",
      "svelte": "./src/recovery.ts",
      "default": "./src/recovery.ts"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./src/auth.ts"
    },
    "./ui": {
      "types": "./src/ui.ts",
      "default": "./src/ui.ts"
    },
    "./observe": {
      "types": "./src/observe.ts",
      "default": "./src/observe.ts"
    },
    "./ui/components": {
      "types": "./src/ui-components.ts",
      "svelte": "./src/ui-components.ts",
      "default": "./src/ui-components.ts"
    },
    "./forms": {
      "types": "./src/forms.ts",
      "svelte": "./src/forms.ts",
      "default": "./src/forms.ts"
    }
  },
  "packageManager": "pnpm@10.30.0",
  "pnpm": {
    "overrides": {
      "cookie": "0.7.2"
    }
  }
}
