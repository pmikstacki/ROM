#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export CARGO_BUILD_JOBS=2
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$PWD/target}"
[[ "$(rustc --version)" == "rustc 1.99.0 "* ]] || { echo 'Run this foundation verifier on the declared Rust 1.99.0 floor' >&2; exit 1; }
rustc --version
cargo fmt --all -- --check
cargo clippy --workspace --all-targets --locked -- -D warnings
cargo test --workspace --locked
cargo clippy -p rom-openrouter --features test-support --all-targets --locked -- -D warnings
cargo test -p rom-openrouter --features test-support --locked
RUSTDOCFLAGS='-D warnings' cargo doc --workspace --no-deps --locked
cargo check -p rom --no-default-features --locked
cargo run -p rom-consumer --locked
cargo tree -p rom --no-default-features --edges normal --locked > "$CARGO_TARGET_DIR/core-dependencies.txt"
if rg -i 'rusqlite|redb|axum|hyper|reqwest|tower|bevy|rom-derive|rom-conformance' "$CARGO_TARGET_DIR/core-dependencies.txt"; then
  echo 'Core imported a concrete DB, transport or disabled derive dependency' >&2
  exit 1
fi
node tests/compile/check.mjs
node tests/ai-tools-compile/check.mjs
cargo fmt --manifest-path examples/ai-flows/Cargo.toml -- --check
cargo clippy --manifest-path examples/ai-flows/Cargo.toml --all-targets --locked -- -D warnings
cargo test --manifest-path examples/ai-flows/Cargo.toml --locked
cargo fmt --manifest-path examples/maintenance-portal/Cargo.toml -- --check
cargo clippy --manifest-path examples/maintenance-portal/Cargo.toml --all-features --all-targets --locked -- -D warnings
cargo test --manifest-path examples/maintenance-portal/Cargo.toml --all-features --locked
./crates/rom-auth/verify

./crates/rom-identity/verify
