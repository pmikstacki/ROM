{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "allowJs": true, "checkJs": true, "verbatimModuleSyntax": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "noEmit": true,
    "paths": {"rom-studio": ["../studio/src/index.ts"], "$lib/*": ["../studio/src/lib/*"]}
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "../studio/src/**/*.ts", "../studio/src/**/*.svelte"],
  "exclude": ["node_modules", "dist"]
}
